{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "build": {
      "commands": [
        "...",
        "cp -r .next/static .next/standalone/.next/static",
        "cp -r public .next/standalone/public",
        "rm -f .next/standalone/.env*"
      ]
    }
  },
  "deploy": {
    "inputs": [
      {
        "step": "packages:mise",
        "include": [
          "/mise/shims",
          "/mise/installs",
          "/usr/local/bin/mise",
          "/etc/mise/config.toml",
          "/root/.local/state/mise"
        ]
      },
      { "step": "build", "include": [".next/standalone"] }
    ],
    "startCommand": "node --max-old-space-size=256 .next/standalone/server.js",
    "variables": { "HOSTNAME": "0.0.0.0", "MALLOC_ARENA_MAX": "2" }
  }
}
